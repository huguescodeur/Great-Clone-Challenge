# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL DSN used by the API.
# In Docker mode this is overridden automatically by docker-compose.
DATABASE_URL=postgres://postgres:password@localhost:5432/insta

# Password used by docker-compose to create the postgres container.
# Must match the password in DATABASE_URL when running locally.
DB_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis address (host:port). In Docker mode overridden by docker-compose.
REDIS_ADDR=localhost:6379

# ── HTTP server ───────────────────────────────────────────────────────────────
PORT=8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens.
# Use a long random string in production (e.g. openssl rand -hex 32).
JWT_SECRET=change_me

# ── Cloudinary (media uploads) ────────────────────────────────────────────────
# Required for the signed-URL upload endpoint (GET /upload/signed-url).
# Create a free account at https://cloudinary.com and copy these values
# from the Dashboard → API Keys section.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: folder inside your Cloudinary account where media is stored.
# Defaults to "insta-lite" if not set.
CLOUDINARY_FOLDER=insta-lite
